# Normalize text files in Git
* text=auto

# Source code and documentation: use LF
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows scripts: use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never normalize line endings
*.jpg -text
*.jpeg -text
*.png -text
*.gif -text
*.bmp -text
*.webp -text
*.ico -text
*.zip -text
*.7z -text
*.rar -text
*.exe -text
*.dll -text
*.pyd -text
*.whl -text
*.pt -text
*.pth -text
*.onnx -text
*.joblib -text
